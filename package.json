{
  "name": "naija-id",
  "version": "0.5.3",
  "description": "Zero-dependency validators, formatters and PII redaction for Nigerian identifiers — phone (E.164), NIN, vNIN, BVN, Tax ID, TIN, CAC, NUBAN, plate, passport, driver's licence and RSA PIN.",
  "keywords": [
    "nigeria",
    "naija",
    "nin",
    "bvn",
    "nuban",
    "vnin",
    "cac",
    "tin",
    "tax-id",
    "rsa-pin"
  ],
  "license": "MIT",
  "author": "Musa Musa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lintdeveloper/naija-id.git"
  },
  "homepage": "https://github.com/lintdeveloper/naija-id#readme",
  "bugs": "https://github.com/lintdeveloper/naija-id/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./standard": {
      "import": {
        "types": "./dist/standard.d.ts",
        "default": "./dist/standard.js"
      },
      "require": {
        "types": "./dist/standard.d.cts",
        "default": "./dist/standard.cjs"
      }
    },
    "./redact": {
      "import": {
        "types": "./dist/redact.d.ts",
        "default": "./dist/redact.js"
      },
      "require": {
        "types": "./dist/redact.d.cts",
        "default": "./dist/redact.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && node scripts/check-conventions.mjs",
    "format": "biome check --write .",
    "check:package": "publint && attw --pack --profile node16",
    "prepublishOnly": "pnpm build && pnpm test",
    "release": "changeset publish",
    "ci:version": "changeset version && biome format --write package.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.9",
    "@vitest/coverage-v8": "^2.1.8",
    "publint": "^0.3.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "packageManager": "pnpm@9.14.2"
}
